<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.order.mapper.ProductSkuMapper">

    <resultMap type="ProductSku" id="ProductSkuResult">
        <id property="id" column="id" />
        <result property="spuId" column="spu_id" />
        <result property="skuName" column="sku_name" />
        <result property="price" column="price" />
        <result property="available" column="available" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <select id="selectProductSkuById" resultMap="ProductSkuResult">
        select id, spu_id, sku_name, price, available, create_time, update_time, remark
        from product_sku
        where id = #{id}
    </select>

    <select id="selectAvailableBySpuId" resultMap="ProductSkuResult">
        select id, spu_id, sku_name, price, available, create_time, update_time, remark
        from product_sku
        where spu_id = #{spuId} and available = 1
        order by id asc
    </select>
</mapper>
